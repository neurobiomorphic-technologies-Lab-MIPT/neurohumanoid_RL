+def make_gymnasium_so101_env(cfg):
+    """Make the MuJoCo SO-101 lift environment."""
+    import os
+    import gymnasium as gym
+    import gym_so101_aawr  # noqa: F401
+    from gymnasium.wrappers import TransformObservation
+
+    scene_path = os.environ["SO101_SCENE_PATH"]
+    profiles_path = os.environ["SO101_RESET_PROFILES"]
+    obs_mode = cfg.modality
+    env = gym.make(
+        "gym_so101_aawr/SO101Lift-v0",
+        scene_path=scene_path,
+        reset_profiles_path=profiles_path,
+        render_mode="rgb_array",
+        max_episode_steps=cfg.episode_length,
+    )
+
+    if obs_mode == "pixels":
+        observation_space = gym.spaces.Box(0, 255, shape=(3, 84, 84), dtype=np.uint8)
+        transform = lambda obs: obs["rgb"].transpose(2, 0, 1)
+    elif obs_mode == "state":
+        observation_space = env.observation_space["state"]
+        transform = lambda obs: obs["state"]
+    else:
+        observation_space = gym.spaces.Dict(
+            {
+                "rgb": gym.spaces.Box(0, 255, shape=(3, 84, 84), dtype=np.uint8),
+                "state": env.observation_space["state"],
+            }
+        )
+
+        def transform(obs):
+            result = {"rgb": obs["rgb"].transpose(2, 0, 1), "state": obs["state"]}
+            if cfg.zero_state:
+                result["state"] = np.zeros_like(result["state"])
+            if cfg.zero_rgb:
+                result["rgb"] = np.zeros_like(result["rgb"])
+            return result
+
+    env = TransformObservation(env, transform, observation_space)
+
+    class GymnasiumToGymWrapper(gym.Wrapper):
+        def __init__(self, env):
+            super().__init__(env)
+            self._reset_seed = cfg.seed
+
+        def reset(self):
+            observation, _ = self.env.reset(seed=self._reset_seed)
+            self._reset_seed = None
+            return observation
+
+        def render(self, **kwargs):
+            return self.env.unwrapped.render(**kwargs)
+
+    env = GymnasiumToGymWrapper(env)
+    if obs_mode == "all":
+        cfg.obs_shape = {key: tuple(int(x) for x in space.shape) for key, space in env.observation_space.items()}
+    else:
+        cfg.obs_shape = tuple(int(x) for x in env.observation_space.shape)
+    cfg.action_shape = tuple(int(x) for x in env.action_space.shape)
+    cfg.action_dim = env.action_space.shape[0]
+
+    for key in ["obs_shape", "action_shape", "action_dim"]:
+        print(key, getattr(cfg, key))
+    return env
+
